# Settings for docker-compose.yml. Copy to .env (ignored by git) and edit:
#
#   cp .env.example .env
#
# Empty or commented-out settings use bin's default. `bin --help` lists them all.

# Root credentials (required: without them bin refuses to start).
# Equivalent names: BIN_ROOT_ACCESS_KEY / BIN_ROOT_SECRET_KEY or BIN_ACCESS_KEY / BIN_SECRET_KEY.
BIN_ROOT_USER=admin
BIN_ROOT_PASSWORD=change-me-to-something-long

# Host ports (defaults: 9000 for the S3 API, 9001 for the console).
BIN_S3_PORT=9000
BIN_CONSOLE_PORT=9001

# Region reported to clients and required in signatures (default us-east-1).
# BIN_REGION=us-east-1

# Domain for virtual-host style requests (bucket.domain); empty = path style only.
# BIN_DOMAIN=s3.example.com

# S3 API URL as clients see it, used in share links; empty = derived from each request.
# BIN_PUBLIC_URL=https://s3.example.com

# Reverse proxies (IPs or CIDRs, comma separated) whose X-Forwarded-For gives
# the real client IP, e.g. 172.16.0.0/12 for a proxy on the same Docker network.
# BIN_TRUSTED_PROXIES=

# Key that encrypts secrets at rest; empty = generated inside the data volume.
# Once set, changing it makes stored secrets unreadable. See README "Backups".
# BIN_MASTER_KEY=

# Logging: level debug|info|warn|error, format text|json, one line per request.
# BIN_LOG_LEVEL=info
# BIN_LOG_FORMAT=text
# BIN_LOG_REQUESTS=true
