{
  "name": "bin-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/styles.css -o src/generated/tailwind.css",
    "css:watch": "tailwindcss -i src/styles.css -o src/generated/tailwind.css --watch",
    "dev": "tailwindcss -i src/styles.css -o src/generated/tailwind.css && vite",
    "typecheck": "tsc --noEmit",
    "build": "tailwindcss -i src/styles.css -o src/generated/tailwind.css --minify && tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('../internal/webui/dist/.gitkeep', '')\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
